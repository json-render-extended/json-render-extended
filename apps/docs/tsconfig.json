{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": {
			"@/*": ["./*"],
			"@json-render-extended/core": ["../../packages/json-render-extended/src/index.ts"],
			"@json-render-extended/core/*": ["../../packages/json-render-extended/src/*"],
			"@json-render-extended/icons": ["../../packages/json-render-icons/src/index.ts"],
			"@json-render-extended/icons/*": ["../../packages/json-render-icons/src/*"],
			"@json-render-extended/playground": ["../../packages/json-render-playground/src/index.ts"],
			"@json-render-extended/playground/*": ["../../packages/json-render-playground/src/*"],
			"@json-render-extended/shadcn": ["../../packages/json-render-shadcn/src/index.ts"],
			"@json-render-extended/shadcn/*": ["../../packages/json-render-shadcn/src/*.ts"]
		}
	},
	"include": ["next-env.d.ts", ".next/types/**/*.ts", "**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules"]
}
