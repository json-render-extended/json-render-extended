{
	"name": "@json-render-extended/docs",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"agent:generate": "pnpm --dir ../.. skills:generate",
		"extension:generate": "pnpm --dir ../.. build:extensions && node ../../packages/json-render-extended/dist/cli.js generate --cwd . --output lib/json-render-extended.generated.ts",
		"registry:generate": "pnpm extension:generate",
		"spec:build": "pnpm --dir ../.. --filter @json-render-extended/playground build && node ../../packages/json-render-playground/dist/cli.js build --cwd . --output json-render/specs.ts",
		"spec:refresh": "pnpm --dir ../.. --filter @json-render-extended/playground build && node ../../packages/json-render-playground/dist/cli.js build --cwd . --output json-render/specs.ts --refresh-materialized",
		"prebuild": "pnpm spec:build && pnpm extension:generate && pnpm agent:generate",
		"predev": "pnpm spec:build && pnpm extension:generate && pnpm agent:generate",
		"playground": "json-render-playground --cwd . --spec docs/package-surface",
		"build": "next build",
		"dev": "next dev --port 3000",
		"start": "next start --port 3000",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "1.6.0",
		"@hugeicons/core-free-icons": "4.2.3",
		"@hugeicons/react": "1.1.9",
		"@json-render-extended/core": "workspace:*",
		"@json-render-extended/icons": "workspace:*",
		"@json-render-extended/playground": "workspace:*",
		"@json-render-extended/shadcn": "workspace:*",
		"@json-render/core": "0.19.0",
		"@json-render/next": "0.19.0",
		"@json-render/react": "0.19.0",
		"@phosphor-icons/react": "2.1.10",
		"@radix-ui/react-use-controllable-state": "^1.2.6",
		"@remixicon/react": "4.9.0",
		"@shikijs/transformers": "^4.4.2",
		"@tabler/icons-react": "3.46.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "1.28.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-icons": "^5.7.0",
		"shiki": "^4.4.2",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.0",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"tailwindcss": "^4.3.0",
		"typescript": "6.0.3"
	}
}
