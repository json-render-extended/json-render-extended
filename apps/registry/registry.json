{
	"$schema": "https://ui.shadcn.com/schema/registry.json",
	"name": "jr-ext",
	"homepage": "https://github.com/json-render-extended/json-render-extended",
	"items": [
		{
			"name": "json-render-extended",
			"type": "registry:item",
			"title": "JSON Render Extended discovery provider",
			"description": "Declares that installed @jr-ext items provide local JSON Render catalog extensions.",
			"meta": {
				"json-render-extended": {
					"protocol": "json-render-extended/v1",
					"mode": "installed-items"
				}
			}
		},
		{
			"name": "code-block-composition-1",
			"type": "registry:block",
			"title": "JSON Render code block composition",
			"description": "Extends the public Shadcnblocks code block with a JSON Render catalog and runtime adapter.",
			"registryDependencies": [
				"@shadcnblocks/code-block/code-block-composition-1",
				"@jr-ext/code-block-composition-1-adapter"
			],
			"meta": {
				"json-render-extended": {
					"protocol": "json-render-extended/v1",
					"mode": "installed-items"
				}
			}
		},
		{
			"name": "code-block-composition-1-adapter",
			"type": "registry:internal",
			"title": "JSON Render code block adapter",
			"description": "Installs the JSON Render catalog, runtime adapter, and local discovery receipt.",
			"dependencies": ["@json-render/react@0.19.0", "lucide-react", "shiki@^4.4.2", "zod@^4.0.0"],
			"files": [
				{
					"path": "registry/jr-ext/code-block-composition-1/catalog.ts",
					"type": "registry:file",
					"target": "lib/json-render-extended/code-block-composition-1.catalog.ts"
				},
				{
					"path": "registry/jr-ext/code-block-composition-1/registry.tsx",
					"type": "registry:file",
					"target": "lib/json-render-extended/code-block-composition-1.registry.tsx"
				},
				{
					"path": "registry/jr-ext/code-block-composition-1/manifest.json",
					"type": "registry:file",
					"target": "lib/json-render-extended/manifests/code-block-composition-1.json"
				}
			],
			"meta": {
				"json-render-extended": {
					"protocol": "json-render-extended/v1",
					"mode": "package",
					"catalog": "@/lib/json-render-extended/code-block-composition-1.catalog",
					"registries": {
						"base-ui": "@/lib/json-render-extended/code-block-composition-1.registry",
						"react-aria": "@/lib/json-render-extended/code-block-composition-1.registry",
						"radix": "@/lib/json-render-extended/code-block-composition-1.registry"
					}
				}
			}
		}
	]
}
