{
	"name": "@json-render-extended/playground",
	"version": "0.0.0",
	"description": "Repository-backed authoring playground and agent API for JSON Render Extended projects.",
	"license": "Apache-2.0",
	"files": [
		"dist",
		"CHANGELOG.md",
		"LICENSE",
		"svelte",
		"README.md"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"json-render-playground": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"import": "./dist/server.js",
			"require": "./dist/server.cjs"
		},
		"./dev-link": {
			"types": "./dist/dev-link.d.ts",
			"import": "./dist/dev-link.js",
			"require": "./dist/dev-link.cjs"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js",
			"require": "./dist/react.cjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"import": "./dist/runtime.js",
			"require": "./dist/runtime.cjs"
		},
		"./svelte": "./svelte/JsonRenderPlaygroundLink.svelte",
		"./client": "./dist/client.js"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@json-render-extended/core": "workspace:*",
		"@json-render/core": "0.19.0",
		"@json-render/react": "0.19.0",
		"@tailwindcss/vite": "^4.3.0",
		"vite": "8.2.1"
	},
	"devDependencies": {
		"@types/node": "24.13.3",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"svelte": "5.53.6",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"svelte": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/json-render-extended/json-render-extended.git",
		"directory": "packages/json-render-playground"
	},
	"homepage": "https://github.com/json-render-extended/json-render-extended/tree/main/packages/json-render-playground#readme",
	"bugs": {
		"url": "https://github.com/json-render-extended/json-render-extended/issues"
	},
	"keywords": [
		"json-render",
		"playground",
		"agent",
		"authoring",
		"generative-ui"
	]
}
